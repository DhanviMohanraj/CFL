# DriftAdapt Environment Configuration Template
# Copy this file to '.env' and fill in the values for local execution.

# Project Settings
ENVIRONMENT=development  # development, staging, production, testing
RANDOM_SEED=42
LOG_LEVEL=INFO

# Directory Configuration (relative or absolute paths)
DATASETS_DIR=./datasets
CHECKPOINTS_DIR=./checkpoints
LOGS_DIR=./logs
EXPERIMENTS_DIR=./experiments

# Foundation Model Integration (Module 2)
# Specify Hugging Face token if using gated models (e.g., Llama-3, Gemma)
HF_TOKEN=your_huggingface_token_here
HF_HOME=./checkpoints/hf_cache

# FastAPI & Network Configuration (Module 1.5/5)
HOST=127.0.0.1
PORT=8000

# Experiment Tracking (Module 10)
# MLFLOW_TRACKING_URI=http://localhost:5000
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT=driftadapt
